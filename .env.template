# Configurações básicas
DEBUG=true
LOG_LEVEL=INFO

# Banco de dados
DATABASE_URL=postgresql://user:password@localhost/maria_db

# Redis
REDIS_URL=redis://localhost:6379

# Interface LLM - Providers
# Claude (Anthropic)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-7-sonnet-20250219
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# Gemini (Google)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7

# Z.AI
ZAI_API_KEY=your-zai-api-key-here
ZAI_MODEL=glm-4.6
ZAI_MAX_TOKENS=4096
ZAI_TEMPERATURE=0.7
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# Configurações gerais LLM
DEFAULT_LLM_PROVIDER=glm

# Segurança
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 dias em minutos

# Configurações de embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_PROVIDER=local

# Configurações de modelos pré-instalados (Docker)
USE_PRELOADED_MODELS=true
TRANSFORMERS_CACHE=/app/.cache/transformers
SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence-transformers

# Configurações de chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Configurações de busca
RAG_TOP_K_CHUNKS=5

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net/v3

# Configurações do fluxo RAG
ENABLE_QUERY_EXPANSION=true
ENABLE_CHUNK_REFINEMENT=true
ENABLE_USER_INPUT_EVALUATION=true
ENABLE_SOURCE_EVALUATION=true

# Configurações de Migrations Automáticas
AUTO_MIGRATIONS=true